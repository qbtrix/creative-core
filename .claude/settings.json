{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledMcpjsonServers": [
    "apple-docs",
    "context7"
  ],
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "WebFetch",
      "WebSearch",
      "Workflow",
      "mcp__apple-docs",
      "mcp__context7",
      "mcp__github"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Workflow|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\"}}'"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "4",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
  },
  "model": "claude-opus-5-5",
  "promptCacheTtl": "1h",
  "workflowSizeGuideline": "small",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "subagentPromptCacheTtl": "1h"
}
