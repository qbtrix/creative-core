#!/usr/bin/env bash
# scripts/ci: the one gate. Runs the no-crash lint, the C4 ownership check,
# the duplicate-code check, swift build and swift test, then prints PASS or
# FAIL and exits with the real status. CI runs exactly this on Linux and
# macOS; run it locally before every PR.
#
# The lint fails on crash-prone constructs in Sources/ (tests are exempt):
#   try!  as!  fatalError(  preconditionFailure(  precondition(  unowned  .first!  .last!
#
# The C4 ownership check keeps docs/c4/model.json current for orientation:
# every Sources/**/*.swift file must be owned by exactly one component's
# `paths` entry (a file, a folder prefix or a glob). Tests/ is not scanned. It
# needs jq and runs a self-test on a scratch tree first.
#
# The duplicate check runs jscpd (pinned) over Sources/ and fails when duplicated
# lines exceed JSCPD_THRESHOLD percent. Baseline on main: 3 clones, 27 lines,
# 0.76%. The threshold only ever goes down: lower it when you remove a clone,
# never raise it. Without npx, or when npm can't fetch jscpd (offline, registry
# not allowlisted), the check prints SKIP and the gate goes on; CI enforces it.
#
# On a Mac with only the Command Line Tools (no Xcode), Swift Testing lives in
# a framework directory swift does not search by default, so we add it.
# bash 3.2 compatible (macOS /bin/bash).
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

fail() { echo; echo "CI: FAIL ($1)"; exit 1; }

echo "== no-crash lint (Sources/)"
pattern='try!|as!|fatalError\(|preconditionFailure\(|precondition\(|unowned |\.first!|\.last!'
if grep -rnE "$pattern" Sources/; then
  fail "no-crash lint: replace the lines above with throwing code"
fi
echo "ok"

echo "== C4 ownership (Sources/ vs docs/c4/model.json)"
# c4_unowned ROOT: "file: why" for each ROOT/Sources/**/*.swift file that is not
# owned by exactly one component in ROOT/docs/c4/model.json; nothing when clean.
# A `paths` entry owns a file when it names it, is a folder prefix of it
# (Sources/CoreColor/ or Sources/CoreColor), or is a glob matching it.
c4_unowned() {
  local pairs f id p owners n
  pairs=$(jq -r '.. | objects | select(has("paths")) | .id as $id | .paths[] | "\($id)\t\(.)"' \
    "$1/docs/c4/model.json") || { echo "docs/c4/model.json: not valid JSON"; return; }
  (cd "$1" && find Sources -name '*.swift' 2>/dev/null | sort) | while IFS= read -r f; do
    owners="" n=0
    while IFS=$'\t' read -r id p; do
      [[ -n "$p" && ", $owners, " != *", $id, "* ]] || continue
      # shellcheck disable=SC2254 # $p is a pattern on purpose
      case "$f" in $p|"${p%/}"/*) owners="$owners${owners:+, }$id"; n=$((n + 1)) ;; esac
    done <<<"$pairs"
    if (( n == 0 )); then echo "$f: no C4 component owns it"
    elif (( n > 1 )); then echo "$f: owned by $n C4 components ($owners)"; fi
  done
}
command -v jq >/dev/null 2>&1 || fail "C4 ownership: jq not found; install jq"
# Self-test: a scratch tree whose model has every path form, and files it must flag.
c4_got=$(
  t="$(mktemp -d)"
  trap 'rm -rf "$t"' EXIT
  mkdir -p "$t/docs/c4" "$t/Sources/A" "$t/Sources/B" "$t/Sources/C" "$t/Sources/CC" "$t/Sources/G"
  printf '%s\n' '{"model":{"systems":[{"containers":[{"components":[
    {"id":"a","paths":["Sources/A/One.swift","Sources/B/"]},
    {"id":"b","paths":["Sources/C","Sources/B/Two.swift","Sources/G/*.swift"]}]}]}]}}' >"$t/docs/c4/model.json"
  for f in A/One A/Loose B/Two C/Three CC/Four G/Five; do : >"$t/Sources/$f.swift"; done
  c4_unowned "$t"
)
c4_want='Sources/A/Loose.swift: no C4 component owns it
Sources/B/Two.swift: owned by 2 C4 components (a, b)
Sources/CC/Four.swift: no C4 component owns it'
if [[ "$c4_got" != "$c4_want" ]]; then
  printf 'want:\n%s\ngot:\n%s\n' "$c4_want" "$c4_got"
  fail "C4 ownership self-test: fix c4_unowned in scripts/ci"
fi
found=$(c4_unowned .)
if [[ -n "$found" ]]; then
  echo "$found"
  fail "C4 ownership: give each file above exactly one owner in docs/c4/model.json (add it to a component's paths, or add a component)"
fi
echo "ok"

echo "== duplicate code (jscpd, Sources/)"
JSCPD_VERSION=5.3.2
JSCPD_THRESHOLD=0.8
if ! command -v npx >/dev/null 2>&1; then
  echo "SKIP (npx not found; install Node 18+ to run this check)"
elif ! npx --yes "jscpd@$JSCPD_VERSION" --version >/dev/null 2>&1; then
  echo "SKIP (npx could not fetch jscpd@$JSCPD_VERSION from the npm registry)"
else
  JSCPD_NO_TIPS=1 npx --yes "jscpd@$JSCPD_VERSION" --format swift --reporters console \
    --threshold "$JSCPD_THRESHOLD" Sources/ \
    || fail "jscpd: duplicated lines over $JSCPD_THRESHOLD%; reuse the existing helper instead of copying it"
fi

flags=()
if [[ "$(uname)" == Darwin ]]; then
  clt=/Library/Developer/CommandLineTools/Library/Developer
  if [[ "$(xcode-select -p 2>/dev/null)" == /Library/Developer/CommandLineTools* && -d "$clt/Frameworks/Testing.framework" ]]; then
    flags=(-Xswiftc -F -Xswiftc "$clt/Frameworks" -Xlinker -F -Xlinker "$clt/Frameworks"
           -Xlinker -rpath -Xlinker "$clt/Frameworks" -Xlinker -rpath -Xlinker "$clt/usr/lib")
  fi
fi

echo "== swift build"
swift build ${flags[@]+"${flags[@]}"} || fail "swift build"

echo "== swift test"
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
swift test ${flags[@]+"${flags[@]}"} 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
(( status == 0 )) || fail "swift test exited $status"

echo
grep -E "Test run with [0-9]+ tests?" "$log" | tail -1
echo "CI: PASS"
